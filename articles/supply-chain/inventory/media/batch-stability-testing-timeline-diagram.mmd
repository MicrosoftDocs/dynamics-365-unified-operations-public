flowchart LR
    P["🟦 Jan 1<br/><b>Last passed</b><br/><br/>(Anchor)"]:::anchor
    E["🟩 Mar 22<br/><b>Early window opens</b><br/><br/><i>Start of test window</i><br/>creates order here"]:::create
    D["🟩 Apr 1<br/><b>Due date</b><br/><br/><i>End of interval</i><br/>creates order here"]:::create
